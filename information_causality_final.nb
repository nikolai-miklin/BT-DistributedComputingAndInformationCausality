Cell["\<\
Definition of calculating in binary using rules, e.g. a0 + a0 = \
2\[CenterDot]a0 = 0, a0\[CenterDot]a0 = a0^2 = a0\
\>", "Text",
 CellChangeTimes->{{3.952418854138998*^9, 3.9524188681462936`*^9}, {
  3.952421079835972*^9, 3.9524210891952705`*^9}, {3.9526057410528393`*^9, 
  3.952605792692194*^9}, {3.9526104168811684`*^9, 3.9526104236750927`*^9}, {
  3.963508934720661*^9, 
  3.9635089349917736`*^9}},ExpressionUUID->"4d87bb98-9a4f-194d-94a6-\
b9201aa2bbf6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Mod2Rules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x_Integer", " ", "/;", 
       RowBox[{"EvenQ", "[", "x", "]"}]}], "->", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x_Integer", "/;", 
       RowBox[{"OddQ", "[", "x", "]"}]}], "->", "1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PowRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Power", "[", 
      RowBox[{"x_", ",", "_"}], "]"}], "->", "x"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BinRules", "=", 
   RowBox[{"Union", "[", 
    RowBox[{"Mod2Rules", ",", "PowRules"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.952605998296116*^9, 3.9526060544763203`*^9}, {
   3.9526060964462223`*^9, 3.952606285549101*^9}, {3.952606345822054*^9, 
   3.95260636496533*^9}, {3.952606395287689*^9, 3.9526064409497128`*^9}, {
   3.952606553773054*^9, 3.9526065539902496`*^9}, {3.953622042032007*^9, 
   3.9536220745197906`*^9}, 3.9537208172460804`*^9},
 CellLabel->
  "In[110]:=",ExpressionUUID->"314c7f7a-8576-d841-a2da-dbcdbf768127"],

Cell["\<\
Mask the multiplications a0\[CenterDot]a1 and a0 a1 with the single symbol \
a0a1 in order to avoid that FreeQ detects a0 or a1 in the multiplications. \
Same with b0\[CenterDot]b1.\
\>", "Text",
 CellChangeTimes->{{3.9472572876322594`*^9, 3.9472573833580513`*^9}, {
  3.9473164687525387`*^9, 3.9473164907913475`*^9}, {3.955522443498598*^9, 
  3.955522456458317*^9}},ExpressionUUID->"0451027e-236b-5447-a5c9-\
a8d367e9a884"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MaskMultRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a0", " ", "a1"}], "->", "a0a1"}], ",", 
     RowBox[{
      RowBox[{"b0", " ", "b1"}], "->", "b0b1"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.947228292456581*^9, 3.9472283450164356`*^9}, {
  3.947248953850996*^9, 3.947248955065531*^9}, {3.947249123977476*^9, 
  3.9472491261030655`*^9}, {3.9472582552675323`*^9, 3.9472582618127174`*^9}, {
  3.951817715795273*^9, 3.9518177163486214`*^9}, {3.9526294631289616`*^9, 
  3.9526294659134808`*^9}, {3.9551783856690845`*^9, 3.955178393085354*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"7673cd38-9474-bc46-b385-1f7a0affc117"]
}, Open  ]],

