     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a1", "+", "1"}], ")"}], 
      RowBox[{"(", "a0", ")"}], " ", 
      RowBox[{"f01", "[", 
       RowBox[{"num", ",", "b1", ",", "b0"}], "]"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "a1", ")"}], 
      RowBox[{"(", 
       RowBox[{"a0", "+", "1"}], ")"}], 
      RowBox[{"f10", "[", 
       RowBox[{"num", ",", "b1", ",", "b0"}], "]"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "a1", ")"}], 
      RowBox[{"(", " ", "a0", ")"}], " ", 
      RowBox[{"f11", "[", 
       RowBox[{"num", ",", "b1", ",", "b0"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
