Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConditionalSetAlt2", "[", "set_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "Result", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Remove", " ", "the", " ", "constant", " ", "1", " ", "from", " ", 
       "every", " ", "element", " ", "in", " ", "the", " ", "set"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Result", "=", 
       RowBox[{"RemoveExprFromTermSet", "[", 
        RowBox[{"set", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Sort", " ", "the", " ", "input", " ", "set"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Result", "=", 
       RowBox[{"Sort", "[", "Result", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Apply", " ", "methods", " ", "until", " ", "set", " ", "does", " ", 
        "not", " ", "change", " ", "anymore"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Result", "=", 
       RowBox[{"FixedPoint", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Sort", "[", 
            RowBox[{"AddIterateSet", "[", 
             RowBox[{"Sort", "[", 
              RowBox[{"ReduceIterateSet", "[", "#", "]"}], "]"}], "]"}], 
            "]"}], ")"}], "&"}], ",", "Result"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ContainsAll", "[", 
         RowBox[{"Result", ",", 
          RowBox[{"{", 
           RowBox[{"a0", ",", "a1"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"a0", ",", "a1"}], "}"}], ",", "Result"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952609736801836*^9, 3.9526097655298615`*^9}, {
