Cell[BoxData[
 RowBox[{
  RowBox[{"CountNLAndInExpr", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Expr", ",", "Coefficients", ",", "n1", ",", "n2", ",", "Coefficients1", 
      ",", "Coefficients2", ",", "ContainesA0A1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Expr", "=", 
      RowBox[{"Expand", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Check", " ", "if", " ", "the", " ", "expression", " ", "contains", " ",
        "a", " ", "\"\<a0\[CenterDot]a1\>\""}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ContainesA0A1", "=", 
      RowBox[{"Not", "[", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"Expr", ",", 
         RowBox[{"a0", " ", "a1"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"ContainesA0A1", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Expression", " ", "contains", " ", "\"\<a0\[CenterDot]a1\>\""}], " ",
         "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Mask", " ", "\"\<a0\[CenterDot]a1\>\"", " ", "in", " ", "order", " ",
          "to", " ", "be", " ", "able", " ", "to", " ", "set", " ", "it", " ",
          "to", " ", "zero", " ", "and", " ", "get", " ", "its", " ", 
         "coefficients"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Expr", "=", 
         RowBox[{"Expr", "/.", 
          RowBox[{
           RowBox[{"a0", " ", "a1"}], "->", "a0a1"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"a0", ",", " ", 
          RowBox[{"a1", " ", "coefficients"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Get", " ", "coefficient", " ", "rules", " ", "for", " ", "a0"}], ",",
           " ", 
          RowBox[{
          "a1", " ", "without", " ", "\"\<a0\[CenterDot]a1\>\"", " ", "by", " ",
            "setting", " ", "it", " ", "to", " ", "zero"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficients1", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{
           RowBox[{"Expr", "/.", 
            RowBox[{"a0a1", "->", "0"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"a0", ",", "a1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "drop", " ", "the", " ", "coefficients", " ", "which", " ", "do", " ",
            "not", " ", "depend", " ", "on", " ", "a0"}], ",", " ", 
          RowBox[{"a1", " ", 
           RowBox[{"(", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"e", ".", "g", ".", " ", "in"}], " ", "the", " ", 
            "expression", " ", "b0"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"b1", ".", " ", "They"}], " ", "do", " ", "not", " ", 
            "contribute", " ", "to", " ", "a", " ", "non"}], "-", 
           RowBox[{"local", " ", 
            RowBox[{"and", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Coefficients1", "=", 
         RowBox[{"KeyDrop", "[", 
          RowBox[{"Coefficients1", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficients1", "=", 
         RowBox[{"Values", "[", "Coefficients1", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Set", " ", "all", " ", "integer", " ", "values", " ", "in", " ", 
           "the", " ", "coefficients", " ", "to", " ", "zero"}], ",", " ", 
          RowBox[{"because", " ", "these", " ", "represent", " ", "a0"}], ",",
           " ", 
          RowBox[{
           RowBox[{"a1", " ", 
            RowBox[{"constants", ".", " ", "They"}], " ", "also", " ", "do", " ",
             "not", " ", "contribute", " ", "to", " ", "a", " ", "non"}], "-", 
           RowBox[{"local", " ", 
            RowBox[{"and", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Coefficients1", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{
           RowBox[{"Coefficients1", "/.", 
            RowBox[{"{", 
             RowBox[{"_Integer", "->", "0"}], "}"}]}], ",", 
           RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Delete", " ", "duplicates", " ", "because", " ", "if", " ", "a0", " ",
            "and", " ", "a1", " ", "have", " ", "the", " ", "same", " ", 
           "coefficients", " ", "this", " ", "results", " ", "in", " ", 
           "only", " ", "one", " ", "non"}], "-", 
          RowBox[{"local", " ", "and"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Coefficients1", "=", 
         RowBox[{"DeleteDuplicates", "[", "Coefficients1", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"\"\<a0\[CenterDot]a1\>\"", " ", "coefficients"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Get", " ", "the", " ", "coefficient", " ", "for", 
          " ", "\"\<a0\[CenterDot]a1\>\""}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Coefficients2", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"Expr", ",", "a0a1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Set", " ", "all", " ", "integer", " ", "values", " ", "in", " ", 
           "the", " ", "coefficients", " ", "to", " ", "zero"}], ",", " ", 
          RowBox[{
           RowBox[{
           "because", " ", "these", " ", "represent", 
            " ", "\"\<a0\[CenterDot]a1\>\"", " ", "as", " ", "a", " ", 
            RowBox[{"constant", ".", " ", "They"}], " ", "do", " ", "not", " ",
             "contribute", " ", "to", " ", "a", " ", "non"}], "-", 
           RowBox[{"local", " ", 
            RowBox[{"and", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Coefficients2", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Coefficients2", "/.", 
             RowBox[{"{", 
              RowBox[{"_Integer", "->", "0"}], "}"}]}], "}"}], ",", 
           RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Get", " ", "linearly", " ", "independent", " ", "elements", " ", 
          "from", " ", "bots", " ", "coefficient", " ", "sets"}], " ", "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"Coefficients", "=", 
         RowBox[{"ConditionalSet", "[", 
          RowBox[{"Union", "[", 
           RowBox[{"Coefficients1", ",", "Coefficients2"}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Count", " ", "the", " ", "number", " ", "of", " ", "final", " ", 
          "coefficients"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Length", "[", "Coefficients", "]"}]}], "\[IndentingNewLine]",
        ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Expression", " ", "does", " ", "not", " ", "contain", 
         " ", "\"\<a0\[CenterDot]a1\>\""}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Get", " ", "the", " ", "coefficient", " ", "rules", " ", "for", " ",
           "a0"}], ",", " ", "a1"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Coefficients", "=", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"Expr", ",", 
           RowBox[{"{", 
            RowBox[{"a0", ",", "a1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "drop", " ", "the", " ", "coefficients", " ", "which", " ", "do", " ",
            "not", " ", "depend", " ", "on", " ", "a0"}], ",", " ", 
          RowBox[{"a1", " ", 
