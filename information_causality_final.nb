Cell["2 Non - local Ands", "Subsubsection",
 CellChangeTimes->{{3.955258957166382*^9, 
  3.955258970324217*^9}},ExpressionUUID->"5aca0ac6-ac69-124d-8fb9-\
9b51bbf7f6e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateExprWith2NLAnd", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Aside", ",", "Bside", ",", "Mul1", ",", "Mul2", ",", 
       "TwoNonLocalAnd"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Multiply", " ", "the", " ", "expressions", " ", "only", " ", 
       "containing", " ", "a", " ", "or", " ", "b", " ", "values"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Aside", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Total", "/@", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a0", ",", "a1", ",", 
              RowBox[{"a0", " ", "a1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Bside", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Total", "/@", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"b0", ",", "b1", ",", 
              RowBox[{"b0", " ", "b1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Mul1", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"bs", ",", 
               RowBox[{"#", "*", "bs"}]}], "]"}], "/@", "Bside"}], ")"}], 
           "&"}], "/@", "Aside"}], ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Mul2", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"bs", ",", 
               RowBox[{"#", "*", 
                RowBox[{"Reverse", "[", "bs", "]"}]}]}], "]"}], "/@", 
             "Bside"}], ")"}], "&"}], "/@", "Aside"}], ",", "1"}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"TwoNonLocalAnd", "=", 
       RowBox[{"Total", "/@", 
        RowBox[{"Union", "[", 
         RowBox[{"Mul1", ",", "Mul2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"TwoNonLocalAnd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"TwoNonLocalAnd", "+", "#"}], ")"}], "&"}], "/@", 
        "CreateExprWith0NLAnds"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"SimplifyBinary", "[", 
        RowBox[{"ExpandAll", "[", 
         RowBox[{"Flatten", "[", "TwoNonLocalAnd", "]"}], "]"}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955262415470085*^9, 3.955262502280697*^9}, {
  3.9552625592900295`*^9, 3.9552626085922337`*^9}, {3.9552626501205254`*^9, 
