Cell["\<\
Uses the conditioning  set X_b to create a set which only contains the \
necessary building blocks, from which every element in X_b can be constructed \
(Minimal Generating Set).
E . g . {a0, a0 + a0 a1, a1 + a0 a1} -> {a0, a1}\
\>", "Text",
 CellChangeTimes->{{3.947318104983183*^9, 3.947318118349184*^9}, {
  3.947318231607939*^9, 3.947318237758854*^9}, {3.952629576857029*^9, 
  3.9526295791121616`*^9}, {3.9635439566609898`*^9, 
  3.9635439872366295`*^9}},ExpressionUUID->"3f70ba59-6793-b745-be0b-\
880a80f2fcf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ConditionalSetAlt1", "[", "set_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Result", ",", " ", "CurrentSet", ",", " ", "SetsDifferentQ"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Remove", " ", "the", " ", "constant", " ", "1", " ", "from", " ", 
       "every", " ", "element", " ", "in", " ", "the", " ", "set"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CurrentSet", "=", 
       RowBox[{"RemoveExprFromTermSet", "[", 
        RowBox[{"set", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Sort", " ", "the", " ", "input", " ", "set"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"CurrentSet", "=", 
       RowBox[{"Sort", "[", "CurrentSet", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Indicates", " ", "if", " ", "the", " ", "previous", " ", "set", " ", 
        "and", " ", "the", " ", "processed", " ", "set", " ", "are", " ", 
        "different"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SetsDifferentQ", "=", "True"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Iterate", " ", "as", " ", "long", " ", "as", " ", "the", " ", 
        "previous", " ", "set", " ", "and", " ", "the", " ", "processed", " ",
         "set", " ", "are", " ", "different"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{"SetsDifferentQ", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Construct", " ", "the", " ", "new", " ", "set", " ", "from", " ", 
          "the", " ", "current", " ", "set"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Result", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"ReduceIterateSet", "[", "CurrentSet", "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Result", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"AddIterateSet", "[", "Result", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "If", " ", "the", " ", "set", " ", "contains", " ", "a0", " ", 
           "and", " ", "a1", " ", "we", " ", "can", " ", "construct", " ", 
           "all", " ", "expression", " ", "from", " ", 
           RowBox[{"these", ".", " ", "Break"}], " ", "and", " ", "return", " ", 
           RowBox[{"{", 
            RowBox[{"a0", ",", " ", "a1"}], "}"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ContainsAll", "[", 
            RowBox[{"Result", ",", 
             RowBox[{"{", 
              RowBox[{"a0", ",", "a1"}], "}"}]}], "]"}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"{", 
             RowBox[{"a0", ",", "a1"}], "}"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"CurrentSet", "===", "Result"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Sets", " ", "are", " ", "the", " ", "same"}], ",", " ", 
             RowBox[{"break", " ", "from", " ", "loop"}]}], "*)"}], 
           "\[IndentingNewLine]", " ", 
           RowBox[{"SetsDifferentQ", "=", "False"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Sets", " ", "are", " ", 
             RowBox[{"different", ".", " ", "Use"}], " ", "the", " ", "new", " ",
              "set", " ", "as", " ", "the", " ", "input", " ", "for", " ", 
             "the", " ", "next", " ", 
             RowBox[{"iteration", "."}]}], "*)"}], "\[IndentingNewLine]", " ", 
           RowBox[{"CurrentSet", " ", "=", " ", "Result"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "Result"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9472303430519447`*^9, 3.9472303494465485`*^9}, {
   3.9472304367815895`*^9, 3.9472304371329956`*^9}, {3.9472356605426292`*^9, 
   3.947235669743538*^9}, {3.9472401384343605`*^9, 3.947240186040041*^9}, {
