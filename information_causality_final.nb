Cell["Gives back the function number for a given expression", "Text",
 CellChangeTimes->{{3.9566570221983376`*^9, 
  3.9566570399537125`*^9}},ExpressionUUID->"2d5b96fc-78d0-0e44-b075-\
ffc8c08dba8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FNumberFromExpression", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "Binary", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Binary", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"SimplifyBinary", "[", 
          RowBox[{"expr", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a1", "->", "a1Val"}], ",", 
             RowBox[{"a0", "->", "a0Val"}], ",", 
             RowBox[{"b1", "->", "b1Val"}], ",", 
             RowBox[{"b0", "->", "b0Val"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a1Val", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"a0Val", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b1Val", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b0Val", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"FromDigits", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", "Binary", "]"}], ",", "2"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.956656097799858*^9, 3.956656135753721*^9}, {
   3.956656198178114*^9, 3.956656384027443*^9}, {3.95665642215522*^9, 
   3.9566564574747257`*^9}, {3.9566564933952026`*^9, 3.9566566672985134`*^9}, 
   3.9566567097000885`*^9, {3.9566568564352417`*^9, 3.9566568642106133`*^9}, {
   3.9566569523480053`*^9, 3.956656956770851*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"7688a3da-586b-3148-8799-c70233d31d35"],

Cell["\<\
Takes four expressions, which are the result of the assignment of the b \
values (00,01,10,11). Returns the function expression, which matches the \
input.\
\>", "Text",
 CellChangeTimes->{{3.956657516237419*^9, 3.9566575421057796`*^9}, {
  3.956657575874399*^9, 
  3.9566576558505096`*^9}},ExpressionUUID->"e55f3911-9e36-d64f-94d8-\
729eb9d8da32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FExprFromBParts", "[", 
   RowBox[{"f00_", ",", "f01_", ",", "f10_", ",", "f11_"}], "]"}], ":=", 
  RowBox[{"SimplifyBinary", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b1", "+", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"b0", "+", "1"}], ")"}], "f00"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b1", "+", "1"}], ")"}], "b0", " ", "f01"}], "+", 
    RowBox[{"b1", 
     RowBox[{"(", 
      RowBox[{"b0", " ", "+", "1"}], ")"}], "f10"}], "+", 
    RowBox[{"b1", " ", "b0", " ", "f11"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9566570649501896`*^9, 3.9566571166343155`*^9}, {
  3.9566573292423496`*^9, 3.9566574360665703`*^9}, {3.956657523395149*^9, 
  3.956657523962631*^9}, {3.956657680155651*^9, 3.9566576816507607`*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"9a04508f-94e0-294d-841f-bf59c8c305b1"],

Cell["\<\
Calculates the expressions of \
f(a_1,a_0,0,0),f(a_1,a_0,0,1),f(a_1,a_0,1,0),f(a_1,a_0,1,1) for a given \
function number.\
\>", "Text",
 CellChangeTimes->{{3.963544454057659*^9, 
  3.9635445184693375`*^9}},ExpressionUUID->"ac51ea07-0f64-6c47-bdbb-\
3b9fff9b3710"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FNumToParts", "[", "num_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", "num", "]"}], "[", 
     RowBox[{"a1", ",", "a0", ",", "0", ",", "0"}], "]"}], ",", 
    RowBox[{
     RowBox[{"F", "[", "num", "]"}], "[", 
     RowBox[{"a1", ",", "a0", ",", "0", ",", "1"}], "]"}], ",", 
    RowBox[{
     RowBox[{"F", "[", "num", "]"}], "[", 
     RowBox[{"a1", ",", "a0", ",", "1", ",", "0"}], "]"}], ",", 
    RowBox[{
     RowBox[{"F", "[", "num", "]"}], "[", 
     RowBox[{"a1", ",", "a0", ",", "1", ",", "1"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9566576598782673`*^9, 3.9566576940350323`*^9}, {
  3.9567387730386677`*^9, 3.9567388572054462`*^9}},
 CellLabel->
  "In[153]:=",ExpressionUUID->"aaa5c774-7b0c-544f-a0a0-f1f764967721"]
}, Closed]],

