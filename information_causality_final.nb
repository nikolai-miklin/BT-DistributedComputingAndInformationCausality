     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", " ", "a1"}], ",", "0"}], "}"}], "->", "IdentityRules"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", " ", "a1"}], ",", "a0"}], "}"}], "->", 
      "IdentityRules"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", " ", "a1"}], ",", "a1"}], "}"}], "->", 
      RowBox[{"{", 
