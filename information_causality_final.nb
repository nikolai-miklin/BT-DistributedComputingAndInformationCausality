     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a0", ",", 
        RowBox[{"a0", " ", "a1"}]}], "}"}], "->", "IdentityRules"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a0", ",", 
        RowBox[{
         RowBox[{"a0", " ", "a1"}], "+", "a1"}]}], "}"}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", 
         RowBox[{"a0", "+", "1"}]}], ",", 
