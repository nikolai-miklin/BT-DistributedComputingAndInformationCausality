Cell[CellGroupData[{

Cell["Alternative 1", "Subsection",
 CellChangeTimes->{{3.9530360011249447`*^9, 3.953036006188797*^9}, {
  3.9530361020810623`*^9, 
  3.9530361043930645`*^9}},ExpressionUUID->"024d0d12-1718-c545-bd1f-\
bdeecdda8c3f"],

Cell["\<\
Iterates over the given set, looks at the current element and tries to reduce \
this element from every following element in the set.
E.g. {a0, a0+a0 a1,a1+a0 a1} \[Rule] {a0,a0 a1,a1}\
\>", "Text",
 CellChangeTimes->{{3.9473172587363853`*^9, 3.9473173345068665`*^9}, {
  3.9473173660405025`*^9, 3.9473175075262375`*^9}, {3.9526295413532543`*^9, 
  3.952629546576374*^9}},ExpressionUUID->"e99f2459-245d-b245-b817-\
d98674341a01"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReduceIterateSet", "[", "set_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Result", ",", "ReductionElement", ",", "FollowingElement", ",", "i", ",",
        "j"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Result", "=", "set"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Iterate", " ", "over", " ", "every", " ", "element", " ", "in", " ", 
        "the", " ", "set"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", " ", "=", " ", "1"}], ",", 
        RowBox[{"i", "<", 
         RowBox[{"Length", "[", "set", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ReductionElement", "=", 
          RowBox[{"Result", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Look", " ", "at", " ", "every", " ", "following", " ", "elements", 
           " ", "in", " ", "the", " ", 
           RowBox[{"set", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"i", "+", "1"}]}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", "set", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Remove", " ", "the", " ", "reduction", " ", "element", " ", 
             "from", " ", "the", " ", "current", " ", "element", " ", "and", " ",
              "store", " ", "it", " ", "at", " ", "the", " ", "same", " ", 
             "index", " ", "in", " ", "the", " ", "set"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FollowingElement", "=", 
             RowBox[{"Result", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Result", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "=", 
             RowBox[{"RemoveExprFromTerm", "[", 
              RowBox[{"FollowingElement", ",", " ", "ReductionElement"}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Reduction", " ", "might", " ", "yield", " ", "0"}], ",", " ", 
        RowBox[{"remove", " ", "these", " ", "elements"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Result", "=", 
       RowBox[{"DeleteElements", "[", 
        RowBox[{"Result", ",", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "Result"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
