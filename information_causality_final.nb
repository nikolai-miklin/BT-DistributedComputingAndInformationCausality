Cell["\<\
Generate expressions with zero non-local ands. 2^7=128 should be all possible \
expressions with 0 non-local ands.\
\>", "Text",
 CellChangeTimes->{{3.9551902291281223`*^9, 3.9551902434132366`*^9}, {
  3.955190283751129*^9, 3.955190313693987*^9}, {3.955256831989254*^9, 
  3.9552568673217907`*^9}, {3.955522315492607*^9, 
  3.9555223185874195`*^9}},ExpressionUUID->"42256873-dc8b-3c42-80c1-\
7ab3a7ad291e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateExprWith0NLAnds", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"AllSubsets", ",", "SummedSubsets"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Generate", " ", "all", " ", "subsets", " ", "of", " ", "the", " ", 
        "terms", " ", "with", " ", "no", " ", "non"}], "-", 
       RowBox[{"local", " ", 
        RowBox[{"and", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AllSubsets", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "a0", ",", "a1", ",", 
          RowBox[{"a0", " ", "a1"}], ",", "b0", ",", "b1", ",", 
          RowBox[{"b0", " ", "b1"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Sum", " ", "up", " ", "the", " ", "subsets"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"SummedSubsets", "=", 
       RowBox[{"Total", "/@", "AllSubsets"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Delete", " ", "duplicate", " ", "values", " ", "and", " ", "return"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"DeleteDuplicates", "[", "SummedSubsets", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9539651108909817`*^9, 3.953965156147333*^9}, {
  3.953965219286455*^9, 3.953965239398329*^9}, {3.9551907784710655`*^9, 
