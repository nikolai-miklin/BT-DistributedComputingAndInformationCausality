Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ApplyAllAffineTransformations", "[", "expr_", "]"}], ":=", 
   RowBox[{"SimplifyBinary", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"expr", "/.", "#"}], ")"}], "&"}], "/@", 
      "AffineTransformationRules"}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9567272306316967`*^9, 3.9567272812370834`*^9}, {
