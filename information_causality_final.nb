Cell["\<\
Tries to figure out if elements from the set can be constructed by adding two \
other elements from the set.
Iterates over the given set, adds the current element and every following \
element. The result will be removed from the set.
E.g.: {a0+a1,a0+a0 a1,a1+a0 a1}->{a0+a1,a0+a0 a1}\
\>", "Text",
 CellChangeTimes->{{3.952417828459772*^9, 3.9524179873044567`*^9}, {
  3.9526295673690166`*^9, 
  3.952629573409233*^9}},ExpressionUUID->"9f0ecb55-10ef-6845-8a33-\
502b2dae742f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddIterateSet", "[", "set_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Result", ",", "ElementsToDelete", ",", "AddedTerm", ",", "i", ",", 
      "j"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Sort", " ", "the", " ", "elements", " ", "in", " ", "ascending", " ", 
      "order"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Result", "=", 
      RowBox[{"Sort", "[", "set", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", " ", "<=", " ", 
        RowBox[{"Length", "[", "Result", "]"}]}], ",", " ", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", " ", "=", " ", 
           RowBox[{"i", " ", "+", " ", "1"}]}], ",", " ", 
          RowBox[{"j", " ", "<=", " ", 
           RowBox[{"Length", "[", "Result", "]"}]}], ",", " ", 
          RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Add", " ", "the", " ", "current", " ", "element", " ", "and", " ",
             "all", " ", "following", " ", "element"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"AddedTerm", "=", 
            RowBox[{"SimplifyBinary", "[", 
             RowBox[{
              RowBox[{"Result", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"Result", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "Remove", " ", "the", " ", "result", " ", "from", " ", "the", " ",
               "set"}], ",", " ", 
             RowBox[{
             "if", " ", "it", " ", "already", " ", "exists", " ", "in", " ", 
              "the", " ", "set"}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"Result", "=", 
            RowBox[{"DeleteElements", "[", 
             RowBox[{"Result", ",", 
              RowBox[{"{", "AddedTerm", "}"}]}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "Result"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.947565188712515*^9, 3.947565213847355*^9}, {
  3.947565249524086*^9, 3.9475652947070103`*^9}, {3.9475653284499855`*^9, 
  3.9475654945940323`*^9}, {3.947565554283144*^9, 3.9475656353829823`*^9}, {
  3.9475656918374023`*^9, 3.9475657411398487`*^9}, {3.9475657782466564`*^9, 
  3.9475657789522934`*^9}, {3.9475658210998344`*^9, 3.9475659043018456`*^9}, {
  3.947566022391962*^9, 3.947566024019207*^9}, {3.9475661588203545`*^9, 
  3.947566232034691*^9}, {3.947566266316223*^9, 3.9475663671720657`*^9}, {
  3.9475663975870953`*^9, 3.9475663981601677`*^9}, {3.9518185672853127`*^9, 
  3.951818597511297*^9}, {3.952415596578804*^9, 3.952415614640665*^9}, {
  3.9524160010556126`*^9, 3.9524160097552357`*^9}, {3.9524160582367096`*^9, 
