Cell["\<\
Applies the binary rules to the term and the conditional set of the given \
mutual information statement .\
\>", "Text",
 CellChangeTimes->{{3.9635452353963585`*^9, 
  3.963545239175482*^9}},ExpressionUUID->"aefbd31f-fa64-c340-9475-\
4339605eb3e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ApplyBinaryRules", "[", "term_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Level", "[", 
    RowBox[{"term", ",", "1"}], "]"}], "//", 
   RowBox[{
    RowBox[{"II", "[", 
     RowBox[{"\"\<g\>\"", ",", 
      RowBox[{"SimplifyBinary", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
      RowBox[{"#", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", 
      RowBox[{"SimplifyBinary", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "]"}]}], "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.9518155356631565`*^9, 3.951815668712223*^9}, {
   3.9518158062489758`*^9, 3.9518158503471546`*^9}, 3.9518159228394394`*^9, {
   3.9526133976948204`*^9, 3.9526134004058075`*^9}, {3.9526208064891205`*^9, 
   3.952620810400099*^9}, {3.9526361882894363`*^9, 3.9526361889774284`*^9}, 
   3.963545222552841*^9},
 CellLabel->
  "In[172]:=",ExpressionUUID->"0b9005a3-a926-bd44-abd5-3913b18bc60e"],

Cell["\<\
Transforms the given IC statement based on the supplied affine transformation \
. This function also reduces the result of the transformation .\
\>", "Text",
 CellChangeTimes->{{3.963545139939123*^9, 
  3.963545144711895*^9}},ExpressionUUID->"7167507b-961c-b243-958f-\
216fc8fb18d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TransformStatement", "[", 
    RowBox[{"stm_", ",", " ", "rule_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "TransformedStmt", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Apply", " ", "the", " ", "rule", " ", 
       RowBox[{"(", 
        RowBox[{"affine", " ", "transformation"}], ")"}], " ", "to", " ", 
       "the", " ", "whole", " ", "ic", " ", 
       RowBox[{"statement", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"TransformedStmt", " ", "=", " ", 
       RowBox[{"stm", "/.", "rule"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Make", " ", "sure", " ", "the", " ", "result", " ", "of", " ", "the", 
        " ", "transformation", " ", "is", " ", "valid", " ", "in", " ", 
        RowBox[{"binary", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"TransformedStmt", " ", "=", " ", 
       RowBox[{"ApplyBinaryRules", "/@", 
        RowBox[{"(", 
         RowBox[{"TransformedStmt", "//", "ExpandAll"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Apply", " ", "the", " ", "usual", " ", "reduction", " ", "to", " ", 
        "the", " ", "result", " ", "of", " ", "the", " ", 
        RowBox[{"transformation", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"TransformedStmt", "=", " ", 
       RowBox[{"ReduceMI", "/@", "TransformedStmt"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "TransformedStmt"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.951814760581316*^9, 3.951814816178335*^9}, {
   3.9518150058508224`*^9, 3.9518150069909306`*^9}, 3.951815334847582*^9, {
   3.9518155102678394`*^9, 3.9518155255457096`*^9}, {3.9518156750447464`*^9, 
   3.9518157006035404`*^9}, {3.9518163949002457`*^9, 3.951816396922964*^9}, 
   3.9518164655073414`*^9, 3.95181664644491*^9, 3.951816729806513*^9, 
   3.9518168591666546`*^9, {3.9518169764952602`*^9, 3.9518170153455048`*^9}, 
   3.952395135611988*^9, {3.9526130219168034`*^9, 3.952613077789469*^9}, {
   3.9526134328547745`*^9, 3.9526134392142124`*^9}, 3.9526201284610386`*^9, {
   3.9526211116314507`*^9, 3.95262114577759*^9}, {3.952621183481617*^9, 
   3.9526211937920456`*^9}, {3.952625593239126*^9, 3.952625609181158*^9}, {
   3.9526256461650124`*^9, 3.952625670878212*^9}, {3.9526257324454136`*^9, 
   3.95262576747176*^9}, {3.9526258459744587`*^9, 3.9526259033815975`*^9}, {
   3.9635451595513935`*^9, 3.9635451597192345`*^9}, {3.9635451920639515`*^9, 
   3.9635451944470444`*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"cb87789e-95d4-9148-9b45-dec62ba9365c"],

Cell["\<\
Returns the IC statement of the given function in a canonized form .\
\>", "Text",
 CellChangeTimes->{{3.9635450632351036`*^9, 
  3.9635450669905434`*^9}},ExpressionUUID->"ace9921d-827c-564d-b06f-\
636715fbd250"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonizedMIS", "[", 
   RowBox[{"fun_", ",", 
    RowBox[{"ord_", ":", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Stmt", ",", "SortedStmt", ",", "FirstRule", ",", "FirstTransformation", 
      ",", "SecondRule", ",", "SecondTransformation", ",", "RemoveBVal"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Calculate", " ", "the", " ", "reduced", " ", "IC", " ", "statement", " ",
       "of", " ", "the", " ", 
      RowBox[{"function", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Stmt", "=", 
      RowBox[{"MISReduced", "[", 
       RowBox[{"fun", ",", "ord"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Sort", " ", "parts", " ", "of", " ", "the", " ", "IC", " ", 
        "statement"}], ",", " ", 
       RowBox[{
        RowBox[{"e", ".", "g", ".", " ", "zeros"}], " ", "to", " ", "the", " ", 
        RowBox[{"back", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"SortedStmt", "=", 
      RowBox[{"SortStatement", "[", "Stmt", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "first", " ", "transformation", " ", "rule", " ",
        "based", " ", "on", " ", "the", " ", "current", " ", "statement", " ",
        "and", " ", "apply", " ", "it", " ", "to", " ", "the", " ", 
       RowBox[{"statement", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"FirstRule", "=", 
      RowBox[{"GetCanonTransformationRule1", "[", "SortedStmt", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FirstTransformation", "=", 
      RowBox[{"SortStatement", "[", 
       RowBox[{"TransformStatement", "[", 
        RowBox[{"SortedStmt", ",", "FirstRule"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Get", " ", "the", " ", "second", " ", "transformation", " ", "rule", " ",
        "based", " ", "on", " ", "the", " ", "first", " ", "transformation", " ",
        "and", " ", "apply", " ", "it", " ", "to", " ", "the", " ", 
       "transformed", " ", 
       RowBox[{"statement", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"SecondRule", "=", 
      RowBox[{"GetCanonTransformationRule2", "[", 
       RowBox[{"FirstTransformation", ",", 
        RowBox[{"GetFirstTermValue", "[", "FirstTransformation", "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"SecondTransformation", "=", 
      RowBox[{"SortStatement", "[", 
       RowBox[{"TransformStatement", "[", 
        RowBox[{"FirstTransformation", ",", "SecondRule"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"RemoveBVal", "=", 
        RowBox[{"SecondTransformation", "/.", 
         RowBox[{
          RowBox[{"II", "[", 
           RowBox[{"g_", ",", "t_", ",", "b_", ",", "xb_"}], "]"}], "->", 
          RowBox[{"II", "[", 
           RowBox[{"g", ",", "t", ",", "\"\<b\>\"", ",", "xb"}], "]"}]}]}]}], 
       ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Map", " ", "mutual", " ", "information", " ", "with", " ", "zero", " ",
        "terms", " ", "to", " ", 
       RowBox[{"zero", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"SecondTransformation", "/.", 
      RowBox[{
       RowBox[{"II", "[", 
        RowBox[{"g_", ",", "0", ",", "b_", ",", "xb_"}], "]"}], "->", 
       "0"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9526205632357407`*^9, 3.952620760656252*^9}, {
   3.9526209673284245`*^9, 3.9526209745279427`*^9}, {3.9526212395924263`*^9, 
   3.9526212993847427`*^9}, {3.9526214288339367`*^9, 
   3.9526214379525337`*^9}, {3.9526216550096226`*^9, 
   3.9526216806279774`*^9}, {3.952621765506199*^9, 3.95262185340077*^9}, {
   3.9526243764996033`*^9, 3.952624433315172*^9}, {3.9526244720767174`*^9, 
   3.9526244787324505`*^9}, {3.952624510396326*^9, 3.952624530692379*^9}, 
   3.952624826229719*^9, {3.952625673021223*^9, 3.9526257033564873`*^9}, {
   3.9526258908146763`*^9, 3.952625933792204*^9}, {3.952626012688429*^9, 
   3.9526260146703854`*^9}, {3.9526288988111973`*^9, 
   3.9526289009622726`*^9}, {3.9526289801740856`*^9, 3.952628991170641*^9}, {
   3.952629795498667*^9, 3.9526297957862606`*^9}, {3.952630044362545*^9, 
   3.9526300890825977`*^9}, {3.9526301193626537`*^9, 
   3.9526301669462013`*^9}, {3.952630272490423*^9, 3.9526302862668266`*^9}, 
   3.9526303244283123`*^9, {3.952630413371954*^9, 3.952630418243988*^9}, {
   3.952630458013155*^9, 3.9526305178670883`*^9}, {3.9526305828441563`*^9, 
   3.9526306229236107`*^9}, 3.952633033406849*^9, {3.9530047055643234`*^9, 
   3.9530047143102837`*^9}, {3.9532022848161373`*^9, 3.9532023260000496`*^9}, 
   3.953202365400097*^9, {3.953219758530981*^9, 3.9532197865624027`*^9}, {
   3.9532216410050735`*^9, 3.9532217396461926`*^9}, {3.953266474941084*^9, 
   3.9532664869187107`*^9}, {3.9635450826790905`*^9, 3.963545118344595*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"9a6bde96-990c-2144-875f-b5e099653430"],

Cell["\<\
Calculate the canonized IC statements for a function for all possible \
orderings .\
\>", "Text",
 CellChangeTimes->{{3.9635450370112915`*^9, 
  3.9635450408464813`*^9}},ExpressionUUID->"7da80086-0340-3745-a88a-\
e460ea631e6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonizedMISAllOrderings", "[", "fun_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"ord", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CanonizedMIS", "[", 
        RowBox[{"fun", ",", "ord"}], "]"}], ",", 
