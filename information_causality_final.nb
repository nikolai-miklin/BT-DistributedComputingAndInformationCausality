     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", " ", "a1"}], ",", 
        RowBox[{"a0", "+", "a1"}]}], "}"}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", 
         RowBox[{"a0", "+", "a1", "+", "1"}]}], ",", 
        RowBox[{"a1", "->", "a1"}]}], "}"}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.952630547300106*^9, 3.9526305581110344`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"5d2480a7-7ae7-7142-886d-f8e963020d55"],

