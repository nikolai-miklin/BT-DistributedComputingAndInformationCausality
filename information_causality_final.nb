Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RemoveExprFromTerm", "[", 
    RowBox[{"term_", ",", " ", "expr_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"term", "/.", "MaskMultRule"}], ",", " ", 
       RowBox[{"expr", "/.", "MaskMultRule"}]}], "]"}], ",", " ", "term", ",",
      " ", 
     RowBox[{"term", "-", "expr"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9472281892478333`*^9, 3.947228287973673*^9}, 
   3.9518177210660152`*^9, 3.952406583072994*^9, 3.952406636266348*^9, 
   3.9526070498952503`*^9, {3.953621940182556*^9, 3.9536219912094154`*^9}, 
   3.953718011106121*^9},
 CellLabel->
  "In[118]:=",ExpressionUUID->"4792c3ba-a853-d646-9e49-cb607c7e5ba6"],

Cell["\<\
Removes the given expression from every term in the given set. For example \
removes the constant 1 from every term: {a0 + 1, a0 a1+1} to {a0, a0 a1}.
First apply the reduction to every item in the set, then delete possible \
duplicate elements and the element 0.\
\>", "Text",
 CellChangeTimes->{{3.947257442249216*^9, 3.947257449522709*^9}, {
  3.947257509143011*^9, 3.9472575688943977`*^9}, {3.9473166663778954`*^9, 
  3.947316695967417*^9}, {3.951818037992647*^9, 3.9518180433244267`*^9}, {
  3.952629514689575*^9, 
  3.9526295189123516`*^9}},ExpressionUUID->"07b964a6-fad3-504d-a72c-\
fec2e042677b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RemoveExprFromTermSet", "[", 
   RowBox[{"set_", ",", "expr_"}], "]"}], ":=", 
  RowBox[{"DeleteElements", "[", 
   RowBox[{
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"RemoveExprFromTerm", "[", 
         RowBox[{"#", ",", "expr"}], "]"}], ")"}], "&"}], "/@", " ", "set"}], 
     "]"}], ",", 
    RowBox[{"{", "0", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.947235646068947*^9, 3.9472356533076744`*^9}, {
   3.9472357425175858`*^9, 3.947235744823309*^9}, {3.9472494989042892`*^9, 
   3.947249500093361*^9}, {3.951817793343832*^9, 3.9518178117329636`*^9}, 
   3.9524065744674892`*^9, 3.952406627714651*^9, {3.952607329198778*^9, 
   3.9526073566149807`*^9}, {3.9526074449116707`*^9, 
   3.9526074465594597`*^9}, {3.953621891918535*^9, 3.9536218946930847`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"c970f996-c478-db4d-9cb8-a0218c2cac2f"],

Cell["\<\
Simplifies a binary expression, e.g. 2 a0 + 3 a1 + a2 * a2 = a1 + a2\
\>", "Text",
 CellChangeTimes->{{3.9473167469989033`*^9, 3.947316761340946*^9}, {
  3.9526076281743526`*^9, 
  3.952607670967037*^9}},ExpressionUUID->"aa9cbe62-2715-8444-abcc-\
0236c84e778a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SimplifyBinary", "[", "expr_", "]"}], ":=", 
   RowBox[{"PolynomialMod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ExpandAll", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"Modulus", "->", "2"}]}], "]"}], "/.", "PowRules"}], ",", 
     "2"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.95241651300889*^9, 3.9524165431524563`*^9}, {
  3.9524166466327076`*^9, 3.952416688343054*^9}, {3.9524169014872093`*^9, 
  3.9524169080266743`*^9}, {3.952417106168789*^9, 3.9524171152569675`*^9}, {
  3.95260759784766*^9, 3.952607598239645*^9}, {3.95362213994228*^9, 
  3.9536221713143864`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"9d5fc55f-2b49-6f4f-a1a6-1cded55a11ba"],

Cell["Sort the given statements by the b value.", "Text",
 CellChangeTimes->{{3.9526127049603996`*^9, 3.952612720804737*^9}, 
   3.953200604656315*^9},ExpressionUUID->"55ce4663-16ab-9249-8842-\
4b0e2ba61a44"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SortByBValue", "[", "stmt_", "]"}], ":=", 
   RowBox[{"SortBy", "[", 
    RowBox[{"stmt", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Level", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], ")"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9526120979750137`*^9, 3.952612141116295*^9}, {
   3.9526124926531734`*^9, 3.952612521717268*^9}, {3.953200622389187*^9, 
   3.9532006263566074`*^9}, 3.9532204298836803`*^9},
 CellLabel->
  "In[121]:=",ExpressionUUID->"8fb18f6f-605a-e742-a71e-bc8b18439a0f"],

Cell["\<\
Sorts the given statement by the length of the conditional set X_b.\
\>", "Text",
 CellChangeTimes->{{3.953718074035692*^9, 
  3.953718094746992*^9}},ExpressionUUID->"555e6dfc-9c65-0842-90bd-\
011f7c21ed1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SortBySetLength", "[", "stmt_", "]"}], ":=", 
  RowBox[{"SortBy", "[", 
   RowBox[{"stmt", ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Length", "[", 
       RowBox[{
        RowBox[{"Level", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}], "]"}], ")"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.953220399278412*^9, 3.9532204659152164`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"1405dcab-b092-a04f-be28-729ae8e9474f"],

Cell["\<\
Sorts the given MI statements. Splits the given statements into the non-zero \
ones and into the ones which equal zero (II[_, 0, _, _]). Sorts the non-zero \
ones by the length of the conditional set and the zero ones by the b value \
and concatenates the resulting list.\
\>", "Text",
 CellChangeTimes->{{3.953200632376589*^9, 3.9532006461267033`*^9}, {
  3.9532006777972565`*^9, 3.9532011645087795`*^9}, {3.9537181183144283`*^9, 
  3.9537181737640724`*^9}},ExpressionUUID->"e2bf8ce0-7b7f-594d-8b1f-\
76226ba3f516"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SortStatement", "[", "stmt_", "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SortBySetLength", "[", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{"stmt", ",", 
        RowBox[{"II", "[", 
         RowBox[{"_", ",", "0", ",", "_", ",", "_"}], "]"}]}], "]"}], "]"}], ",", 
     RowBox[{"SortByBValue", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"stmt", ",", 
        RowBox[{"II", "[", 
         RowBox[{"_", ",", "0", ",", "_", ",", "_"}], "]"}]}], "]"}], "]"}]}],
     "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.952611232679188*^9, 3.9526112442433376`*^9}, {
   3.952611305835472*^9, 3.9526113080248165`*^9}, {3.9526113887874336`*^9, 
   3.952611435724842*^9}, {3.952611522586609*^9, 3.9526115415862007`*^9}, {
   3.9526115926596794`*^9, 3.9526116171866264`*^9}, {3.9526118283312855`*^9, 
   3.952611969371683*^9}, {3.952612064196211*^9, 3.952612118060278*^9}, {
   3.952612386324774*^9, 3.9526124395088577`*^9}, 3.9532204779645576`*^9},
 CellLabel->
  "In[123]:=",ExpressionUUID->"bbae93df-18d9-7d47-b985-e4d05e20f5a7"],

Cell["Get the Class name from a MIS statement in canonized form.", "Text",
 CellChangeTimes->{{3.9538242378528805`*^9, 
  3.9538242627396355`*^9}},ExpressionUUID->"f2f65364-b9ce-8343-bc09-\
c748fbe2c113"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetClass", "[", "v_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"TermAndConditionalSet", ",", "StatementWithoutBValue"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Extract", " ", "Term", " ", "and", " ", "Conditional", " ", "Set", " ", 
      "from", " ", "all", " ", "elements", " ", "except", " ", "when", " ", 
      "they", " ", "are", " ", "zero"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TermAndConditionalSet", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "===", "0"}], ",", "0", ",", 
           RowBox[{
            RowBox[{"Level", "[", 
             RowBox[{"#", ",", "1"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"{", 
              RowBox[{"2", ",", "4"}], "}"}], "]"}], "]"}]}], "]"}], ")"}], 
        "&"}], "/@", "v"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Construct", " ", "II", " ", "again", " ", "from", " ", "Term", " ", 
       "and", " ", "Cond", " ", "Set", " ", "but", " ", "without", " ", "b", " ",
        "value", " ", "this", " ", "time"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"StatementWithoutBValue", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "===", "0"}], ",", "0", ",", 
           RowBox[{"II", "[", 
            RowBox[{"\"\<g\>\"", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<b\>\"", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], ")"}], "&"}], 
       "/@", "TermAndConditionalSet"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Lookup", " ", "Statement", " ", "in", " ", "association"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ClassNames", "[", "StatementWithoutBValue", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9526333427042427`*^9, 3.952633400262295*^9}, {
   3.952633434341671*^9, 3.9526334842465878`*^9}, {3.9526335384859943`*^9, 
   3.952633556262659*^9}, {3.9526338467745724`*^9, 3.9526338615743523`*^9}, {
   3.952633927847271*^9, 3.95263406439954*^9}, {3.9526340970640965`*^9, 
