Cell[CellGroupData[{

Cell["Reduction Function", "Section",
 CellChangeTimes->{{3.9472420497169704`*^9, 
  3.9472420615403137`*^9}},ExpressionUUID->"05aef45f-daae-9a4c-9412-\
2c80e1fb7cc7"],

Cell["\<\
Reduces the expression with the values from the given set. Returns the \
expression and a minimal generating set with the basic building blocks, being \
able to construct the original set.\
\>", "Text",
 CellChangeTimes->{{3.9473186550919437`*^9, 3.9473187278138714`*^9}, {
  3.963544110749346*^9, 
  3.9635441796441765`*^9}},ExpressionUUID->"057c2c2e-957b-9c4e-bfca-\
3a9445853a3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Reduction", "[", 
   RowBox[{"term_", ",", " ", "set_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "TermWithoutConstant", ",", "CondSet", ",", "AddSet", ",", "ProductSet", 
      ",", "ConditionalSetWithOne", ",", "ReducedTerm"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Remove", " ", "the", " ", "constant", " ", "1", " ", "from", " ", 
       "the", " ", "term", " ", "if", " ", "it", " ", "exists"}], ",", " ", 
      RowBox[{
       RowBox[{"e", ".", "g", ".", " ", "a0"}], " ", "+", " ", 
       RowBox[{"1", " ", "to", " ", "a0"}]}]}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TermWithoutConstant", "=", 
      RowBox[{"RemoveExprFromTerm", "[", 
       RowBox[{"term", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Construct", " ", "the", " ", "conditional", " ", "set"}], ",",
        " ", 
       RowBox[{
       "which", " ", "contains", " ", "only", " ", "the", " ", "basic", " ", 
        "building", " ", "blocks"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"CondSet", " ", "=", " ", 
      RowBox[{"ConditionalSet", "[", "set", "]"}]}], ";", 
     "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Add", " ", "all", " ", "elements", " ", "from", " ", "the", " ", 
        "minimal", " ", "generating", " ", "set", " ", "together", " ", "in", 
        " ", "order", " ", "to", " ", "be", " ", "able", " ", "to", " ", 
        "construct", " ", "all", " ", "possible", " ", "elements"}], ",", " ", 
       RowBox[{
       "which", " ", "can", " ", "be", " ", "derived", " ", "from", " ", 
        "these", " ", 
        RowBox[{"elements", ".", " ", "\[IndentingNewLine]", "Add"}], " ", 
        "0", " ", "in", " ", "order", " ", "to", " ", "preserve", " ", "the", 
        " ", "singleton", " ", "elements"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"AddSet", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Plus", " ", "@@@", 
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"Union", "[", 
              RowBox[{"CondSet", ",", 
               RowBox[{"{", "0", "}"}]}], "]"}], ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "//.", "Mod2Rules"}], 
        "//", 
        RowBox[{
         RowBox[{"DeleteElements", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", "0", "}"}]}], "]"}], "&"}]}], "//", 
       "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Add", " ", "one", " ", "to", " ", "the", " ", "conditional", " ", 
        RowBox[{"set", ".", " ", "When"}], " ", "creating", " ", "the", " ", 
        "product", " ", "set"}], ",", " ", 
       RowBox[{
       "we", " ", "want", " ", "to", " ", "preserve", " ", "the", " ", 
        "singleton", " ", "elements", " ", "from", " ", "this", " ", "set"}], 
       ",", " ", 
       RowBox[{
       "therefore", " ", "we", " ", "add", " ", "one", " ", "to", " ", "this",
         " ", 
        RowBox[{"set", ".", "\[IndentingNewLine]", "Because"}], " ", "when", " ",
         "multiplying", " ", "with", " ", "one"}], ",", " ", 
       RowBox[{"the", " ", "elements", " ", "stay", " ", "in", " ", "the", " ", 
        RowBox[{"set", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ConditionalSetWithOne", " ", "=", " ", 
      RowBox[{"Union", "[", 
       RowBox[{"AddSet", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Create", " ", "the", " ", "product", " ", "set", " ", "by", " ", 
       "creating", " ", "all", " ", "possible", " ", "subsets", " ", "of", " ",
        "length", " ", "2", " ", "and", " ", "then", " ", "multiplying", " ", 
       "the", " ", "elements", " ", "in", " ", "these", " ", "sets"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"ProductSet", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", " ", "@@@", 
         RowBox[{"Subsets", "[", 
          RowBox[{"ConditionalSetWithOne", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "//", 
       "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Reduce", " ", "the", " ", "given", " ", "term", " ", "by", " ", 
       "trying", " ", "to", " ", "remove", " ", "every", " ", "element", " ", 
       "in", " ", "the", " ", "product", " ", "set", " ", "from", " ", "the", 
       " ", "term"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ReducedTerm", "=", 
      RowBox[{"Fold", "[", 
       RowBox[{
       "RemoveExprFromTerm", ",", "TermWithoutConstant", ",", "ProductSet"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ReducedTerm", ",", "CondSet"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9466361064607677`*^9, 3.946636115250458*^9}, {
   3.9466368375280685`*^9, 3.9466368711559925`*^9}, {3.946636902534132*^9, 
   3.9466369034212685`*^9}, {3.9466376457787743`*^9, 
