Cell[BoxData[
 RowBox[{
  RowBox[{"ConditionalSetAlt3", "[", "set_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setWithoutConst", ",", "basis", ",", "matrix", ",", "reduced"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"setWithoutConst", "=", 
      RowBox[{"RemoveExprFromTermSet", "[", 
       RowBox[{"set", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"basis", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"SplitAddition", "[", "setWithoutConst", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"basis", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Sort", "[", "basis", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"matrix", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"MapToVector", "[", 
         RowBox[{"#", ",", "basis"}], "]"}], "&"}], "/@", 
       "setWithoutConst"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"reduced", "=", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RowReduce", "[", 
          RowBox[{"matrix", ",", 
           RowBox[{"Modulus", "->", "2"}]}], "]"}], ".", "basis"}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Sort", "[", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "#", "]"}], "===", "Times"}], ",", 
             RowBox[{"DeleteMultRedundancy", "[", 
              RowBox[{"#", ",", "reduced"}], "]"}], ",", "#"}], "]"}], ")"}], 
          "&"}], "/@", "reduced"}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9530185921885624`*^9, 3.9530186678529034`*^9}, 
   3.9530187253731747`*^9, {3.953018766448801*^9, 3.953018836531872*^9}, {
