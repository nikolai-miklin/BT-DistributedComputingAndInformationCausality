Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FunctionTruthTable", "[", "num_", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", "a0", ",", "b1", ",", "b0"}], "}"}], "->", 
       RowBox[{
        RowBox[{"F", "[", "num", "]"}], "[", 
        RowBox[{"a1", ",", "a0", ",", "b1", ",", "b0"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"b0", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
