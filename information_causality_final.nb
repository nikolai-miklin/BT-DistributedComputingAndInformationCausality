Cell["\<\
Get all affine transformations by multiplying the invertible matrices with \
the vector and adding constants 0 and 1.\
\>", "Text",
 CellChangeTimes->{{3.9567267752088776`*^9, 
  3.9567268113571815`*^9}},ExpressionUUID->"491cbc1c-267b-fa4f-b796-\
cddadac7ed50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AffineTransformationRule", "[", 
   RowBox[{"i_", ",", " ", "j_", ",", " ", "k_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a0", "->", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"MatrizesI", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ".", "avec"}], ")"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "+", "i"}]}], ",", " ", 
    RowBox[{"a1", "->", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"MatrizesI", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ".", "avec"}], ")"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "+", "j"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9517992356085854`*^9, 3.951799265865078*^9}, {
  3.9517993512485237`*^9, 3.951799447025324*^9}, {3.951799527020258*^9, 
  3.951799532458153*^9}, {3.951799576314951*^9, 3.951799722077379*^9}, {
  3.9517997615610332`*^9, 3.9517997715401993`*^9}, {3.9517998352855797`*^9, 
  3.9517998778227615`*^9}, {3.9517999615548267`*^9, 3.9517999907063885`*^9}, {
  3.9567267546047897`*^9, 3.956726759980772*^9}},
