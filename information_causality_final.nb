Cell[BoxData[{
 RowBox[{
  RowBox[{"IP", "[", 
   RowBox[{"a1_", ",", " ", "a0_", ",", " ", "b1_", ",", " ", "b0_"}], "]"}], 
  " ", ":=", 
  RowBox[{
   RowBox[{"a0", " ", "b0"}], "+", 
   RowBox[{"a1", " ", "b1"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DISJ", "[", 
   RowBox[{"a1_", ",", " ", "a0_", ",", " ", "b1_", ",", " ", "b0_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"1", " ", "+", 
   RowBox[{"a0", " ", "b0"}], " ", "+", " ", 
   RowBox[{"a1", " ", "b1"}], " ", "+", " ", 
   RowBox[{"a0", " ", "b0", " ", "a1", " ", "b1"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EQ", "[", 
   RowBox[{"a1_", ",", " ", "a0_", ",", " ", "b1_", ",", " ", "b0_"}], "]"}], 
  ":=", 
  RowBox[{
   RowBox[{"a0", " ", "a1"}], "+", " ", 
   RowBox[{"a0", " ", "b1"}], "+", "a0", "+", 
   RowBox[{"b0", " ", "a1"}], "+", 
   RowBox[{"b0", " ", "b1"}], "+", "b0", "+", "a1", "+", "b1", "+", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"INDEX", "[", 
   RowBox[{"a1_", ",", "a0_", ",", "b1_", ",", "b0_"}], "]"}], ":=", 
  RowBox[{"a0", "+", 
   RowBox[{"a0", " ", "b0"}], "+", 
   RowBox[{"a1", " ", "b0", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b0", "+", "1"}], ")"}], "\[CenterDot]", "a0"}], " ", "+", 
      " ", 
      RowBox[{"a1", "\[CenterDot]", "b0"}]}], "*)"}]}]}]}]}], "Input",
