Cell["\<\
Counts the number of non - local AND operations for the given expression .\
\>", "Text",
 CellChangeTimes->{{3.963544648378683*^9, 
  3.963544652505842*^9}},ExpressionUUID->"aa154481-8561-3d4c-8704-\
9fc59851e560"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CountNLAndInExpr2", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Expr", ",", "Coefficients", ",", "Coefficients1", ",", "Coefficients2", 
      ",", "Coefficients3"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Expr", "=", 
      RowBox[{"Expand", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Expr", "=", 
      RowBox[{"Expr", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a0", " ", "a1"}], "->", "a0a1"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Coefficients1", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"Expr", ",", "a1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Coefficients2", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"Expr", ",", "a0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Coefficients3", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"Expr", ",", "a0a1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Coefficients", "=", 
      RowBox[{"{", 
       RowBox[{"Coefficients1", ",", "Coefficients2", ",", "Coefficients3"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Set", " ", "all", " ", "integer", " ", "values", " ", "in", " ", 
        "the", " ", "coefficients", " ", "to", " ", "zero"}], ",", " ", 
       RowBox[{"because", " ", "these", " ", "represent", " ", "a0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"a1", " ", 
         RowBox[{"constants", ".", " ", "They"}], " ", "also", " ", "do", " ",
          "not", " ", "contribute", " ", "to", " ", "a", " ", "non"}], "-", 
        RowBox[{"local", " ", 
         RowBox[{"and", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Coefficients", "=", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{
        RowBox[{"Coefficients", "/.", 
         RowBox[{"{", 
          RowBox[{"_Integer", "->", "0"}], "}"}]}], ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Delete", " ", "duplicates", " ", "because", " ", "if", " ", "a0", " ",
         "and", " ", "a1", " ", "have", " ", "the", " ", "same", " ", 
        "coefficients", " ", "this", " ", "results", " ", "in", " ", "only", " ",
         "one", " ", "non"}], "-", 
       RowBox[{"local", " ", "and"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Coefficients", "=", 
      RowBox[{"DeleteDuplicates", "[", "Coefficients", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Count", " ", "the", " ", "number", " ", "of", " ", "final", " ", 
       "coefficients"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Length", "[", 
      RowBox[{"ConditionalSet", "[", "Coefficients", "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
