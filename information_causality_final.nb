Cell["\<\
Affine transformations for the first canonization step. Maps the term to the \
transformation: When the term is found in the first summand of the IC \
statement, the corresponding transformation should be applied.\
\>", "Text",
 CellChangeTimes->{{3.953718983874052*^9, 3.95371899936858*^9}, {
  3.953719153002716*^9, 3.9537192385137463`*^9}, {3.9538077464426937`*^9, 
  3.953807746577833*^9}},ExpressionUUID->"af10947c-9cbe-0f4d-9889-\
3d729a4f5fba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonTransformationRules1", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"0", "->", "IdentityRules"}], ",", "\[IndentingNewLine]", 
     RowBox[{"a0", "->", "IdentityRules"}], ",", "\[IndentingNewLine]", 
     RowBox[{"a1", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", "a1"}], ",", 
        RowBox[{"a1", "->", "a0"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a0", "+", "a1"}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", 
         RowBox[{"a0", "+", "a1"}]}], ",", 
        RowBox[{"a1", "->", "a1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a0", " ", "a1"}], "->", "IdentityRules"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a0", "+", 
       RowBox[{"a0", " ", "a1"}]}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", "a0"}], ",", 
        RowBox[{"a1", "->", 
         RowBox[{"a1", "+", "1"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a1", "+", 
       RowBox[{"a0", " ", "a1"}]}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", 
         RowBox[{"a0", "+", "1"}]}], ",", 
        RowBox[{"a1", "->", "a1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a0", "+", "a1", "+", 
       RowBox[{"a0", " ", "a1"}]}], "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a0", "->", 
         RowBox[{"a0", "+", "a1"}]}], ",", 
        RowBox[{"a1", "->", 
         RowBox[{"a1", "+", "1"}]}]}], "}"}]}]}], " ", "\[IndentingNewLine]", 
    "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9526289284353657`*^9, 3.9526289293703003`*^9}, 
   3.953717965494465*^9},
 CellLabel->
  "In[115]:=",ExpressionUUID->"dab3e696-a868-5443-a937-afd3024b5980"],

Cell["\<\
Affine transformations for the second canonization step. Maps two terms to \
the transformation: If the first term is found in the first summand of the IC \
statement and the second term is found in the second term of the IC \
statement, the corresponding transformation should be applied.\
\>", "Text",
 CellChangeTimes->{{3.953719002649292*^9, 3.9537190274454784`*^9}, {
  3.9537192473309593`*^9, 3.9537193140873184`*^9}, {3.9538077579273434`*^9, 
