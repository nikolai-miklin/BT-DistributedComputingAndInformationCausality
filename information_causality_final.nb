Cell[BoxData[
 RowBox[{
  RowBox[{"DeleteMultRedundancy", "[", 
   RowBox[{"expr_", ",", "set_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setWithoutExpr", ",", "ProdSet"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"setWithoutExpr", "=", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{"set", ",", 
        RowBox[{"{", "expr", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ProdSet", "=", 
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Flatten", "[", 
           RowBox[{"TensorProduct", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "#2"}], "}"}], "]"}]}], "]"}], "]"}], ")"}], 
         "&"}], ",", 
        RowBox[{"{", "1", "}"}], ",", "setWithoutExpr"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"ProdSet", ",", "expr"}], "]"}], ",", "0", ",", "expr"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
