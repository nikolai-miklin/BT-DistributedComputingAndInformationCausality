Cell[BoxData[
 RowBox[{
  RowBox[{"FFac", "[", "num_", "]"}], " ", ":=", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1", ",", "a0", ",", "b1", ",", "b0"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a1", "+", "1"}], ")"}], 
