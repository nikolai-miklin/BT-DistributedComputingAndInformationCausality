Cell["\<\
Definition of all binary functions with four bits as input. BitGet[n,x] gets \
the constant c^x term for the function. Each function has 16 constants (c^0 - \
c^15). Enumerating n from 0 to 2^2^n-1 produces all 65536 functions.\
\>", "Text",
 CellChangeTimes->{{3.9538079910216675`*^9, 
  3.9538081536558495`*^9}},ExpressionUUID->"1c9d20cb-ff38-2040-920e-\
0a495a1dbb3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f00", "[", 
   RowBox[{"num_", ",", "b1_", ",", "b0_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b1", "+", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"b0", "+", "1"}], ")"}], 
    RowBox[{"BitGet", "[", 
     RowBox[{"num", ",", "0"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"b1", "+", "1"}], ")"}], " ", "b0", " ", 
    RowBox[{"BitGet", "[", 
     RowBox[{"num", ",", "1"}], "]"}]}], "+", 
   RowBox[{"b1", 
    RowBox[{"(", 
     RowBox[{"b0", "+", "1"}], ")"}], " ", 
    RowBox[{"BitGet", "[", 
     RowBox[{"num", ",", "2"}], "]"}]}], " ", "+", " ", 
   RowBox[{"b0", " ", "b1", " ", 
