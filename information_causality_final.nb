Cell[CellGroupData[{

Cell["1 Non - local And", "Subsubsection",
 CellChangeTimes->{{3.9552580688455143`*^9, 
  3.955258082140875*^9}},ExpressionUUID->"db025da7-99c8-2047-b30a-\
597d699197ec"],

Cell["Generate expressions with exactly 1 non - local and .", "Text",
 CellChangeTimes->{{3.955257002520218*^9, 
  3.955257029232584*^9}},ExpressionUUID->"63acca6d-7037-1045-aad7-\
f66ff95a71e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateExprWith1NLAnd", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Aside", ",", "Bside", ",", "OneNonLocalAnd"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Multiply", " ", "the", " ", "expressions", " ", "only", " ", 
       "containing", " ", "a", " ", "or", " ", "b", " ", "values"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Aside", "=", 
       RowBox[{"Total", "/@", 
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a0", ",", "a1", ",", 
            RowBox[{"a0", " ", "a1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Bside", "=", 
       RowBox[{"Total", "/@", 
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"b0", ",", "b1", ",", 
            RowBox[{"b0", " ", "b1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"OneNonLocalAnd", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"TensorProduct", "[", 
         RowBox[{"Aside", ",", "Bside"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Add", " ", "expressions", " ", "with", " ", "0", " ", "non"}], "-", 
        RowBox[{
        "local", " ", "ands", " ", "to", " ", "the", " ", "expressions", " ", 
         "with", " ", "one", " ", "non"}], "-", 
        RowBox[{"local", " ", "and"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"OneNonLocalAnd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"OneNonLocalAnd", "+", "#"}], ")"}], "&"}], "/@", 
        "CreateExprWith0NLAnds"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", "OneNonLocalAnd", "]"}]}]}], 
