Cell[CellGroupData[{

Cell["Mutual Information Sum Definition", "Section",
 CellChangeTimes->{{3.947247782739233*^9, 3.947247790640211*^9}, {
  3.9538238811743336`*^9, 
  3.9538238832774773`*^9}},ExpressionUUID->"647e394c-d4e5-ca4a-bfed-\
66dd7403076b"],

Cell["\<\
Definition of set X_b. fun is the function which should be called with \
concrete b1 and b0 values. idxs gives the ordering of the b values, e.g. for \
the ordering {1,3,0,2} the function Xb will be called with the idxs {}, {1}, \
{1,3} and {1,3,0}.\
\>", "Text",
 CellChangeTimes->{{3.9473197823872166`*^9, 3.9473197889318466`*^9}, 
   3.9538160228781624`*^9, {3.953823362326952*^9, 
   3.9538235150589676`*^9}},ExpressionUUID->"a12a83c7-d8d3-084a-b44a-\
f5e2c61d33c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Xb", "[", 
    RowBox[{"fun_", ",", " ", "idxs_"}], "]"}], " ", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"SimplifyBinary", "/@", 
      RowBox[{"(", 
       RowBox[{"fun", "[", 
        RowBox[{"a1", ",", " ", "a0", ",", " ", 
         RowBox[{"BitGet", "[", 
          RowBox[{"#", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"BitGet", "[", 
          RowBox[{"#", ",", " ", "0"}], "]"}]}], "]"}], ")"}]}], "&"}], "/@", 
    "idxs"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9532070124922714`*^9, 3.953207047892418*^9}, {
  3.9532071154284973`*^9, 3.95320713939616*^9}, {3.953817187903263*^9, 
  3.9538171924542465`*^9}, {3.953822497768833*^9, 3.953822537833948*^9}, {
  3.9538225891215496`*^9, 3.95382260216963*^9}, {3.9538230776511345`*^9, 
  3.953823079943342*^9}, {3.9538231728985863`*^9, 3.953823176242346*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"4b1d3ab1-d8ce-424b-b203-93782b2a5b29"],

Cell["\<\
Definition of the Mutual Information Sum. fun is the function and ord \
describes the ordering. Returns a list of summands and not summation \
(Mathemtica sometimes orders the summands in a sum weird and in this way we \
preserve the ordering of ord).\
\>", "Text",
 CellChangeTimes->{{3.9473200740027943`*^9, 3.947320084216631*^9}, {
  3.95382353337237*^9, 
  3.953823618604763*^9}},ExpressionUUID->"b12d0ca9-1af5-6b4c-94b0-\
5e6630680bef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MIS", "[", 
    RowBox[{"fun_", ",", 
     RowBox[{"ord_", ":", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"II", "[", 
       RowBox[{"\"\<g\>\"", ",", 
        RowBox[{"SimplifyBinary", "[", 
         RowBox[{"fun", "[", 
          RowBox[{"a1", ",", "a0", ",", 
           RowBox[{"BitGet", "[", 
            RowBox[{
             RowBox[{"ord", "[", 
              RowBox[{"[", "#", "]"}], "]"}], ",", " ", "1"}], "]"}], ",", 
           RowBox[{"BitGet", "[", 
            RowBox[{
             RowBox[{"ord", "[", 
              RowBox[{"[", "#", "]"}], "]"}], ",", "0"}], "]"}]}], "]"}], 
         "]"}], ",", 
        RowBox[{"ord", "[", 
         RowBox[{"[", "#", "]"}], "]"}], ",", " ", 
        RowBox[{"Xb", "[", 
         RowBox[{"fun", ",", " ", 
          RowBox[{"ord", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"#", "-", "1"}]}], "]"}], "]"}]}], "]"}]}], "]"}], ")"}],
      "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"1", ",", "n"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9422190049387608`*^9, 3.9422191484206696`*^9}, {
