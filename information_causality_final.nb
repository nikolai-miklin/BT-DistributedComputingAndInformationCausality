   3.9538230561263294`*^9, 3.9538230571967564`*^9}, {3.953823178418396*^9, 
   3.953823185135887*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"d6858f2b-2712-3e44-a67f-f2f6699f4aeb"],

Cell["\<\
Reduces a Mutual Information statement. Break it up, reduce the term, \
construct a new statement from the reduced term and the conditional set\
\>", "Text",
 CellChangeTimes->{{3.947320094913761*^9, 
  3.947320216718876*^9}},ExpressionUUID->"3a16c97c-2335-594b-b01b-\
0e108a6242ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReduceMI", "[", "ii_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Level", "[", 
     RowBox[{"ii", ",", " ", "1"}], "]"}], "//", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Reduction", "[", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}], ")"}], "&"}]}], "//", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"II", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Level", "[", 
         RowBox[{"ii", ",", "1"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ")"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.947252189016485*^9, 3.9472521906579304`*^9}, {
  3.9472522215339127`*^9, 3.947252222116495*^9}, {3.952636211098648*^9, 
  3.9526362116894703`*^9}, {3.9538165403594685`*^9, 3.9538165604827156`*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"4b441b56-16ae-4948-968d-0e8f52c9a9f2"],

Cell["\<\
Reduced mutual information sum. Construct the normal MIS and then reduces \
each statement individually\
\>", "Text",
 CellChangeTimes->{{3.9473202488884583`*^9, 3.947320329449463*^9}, {
  3.9532022178614902`*^9, 
  3.953202236230732*^9}},ExpressionUUID->"3b7a0e0e-ca84-614d-8e31-\
7ec97a4de01a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MISReduced", "[", 
   RowBox[{"fun_", ",", 
    RowBox[{"ord_", ":", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}]}], "]"}], ":=", 
  "  ", 
  RowBox[{"ReduceMI", " ", "/@", " ", 
   RowBox[{"MIS", "[", 
    RowBox[{"fun", ",", "ord"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9526108187223186`*^9, 3.952610819083103*^9}, 
   3.952610894843073*^9, {3.952621380480425*^9, 3.9526213840403767`*^9}, {
