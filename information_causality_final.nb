   3.947318794514759*^9}, {3.947318857982975*^9, 3.9473190358350124`*^9}, {
   3.9473190825396423`*^9, 3.947319246986431*^9}, {3.947563859616884*^9, 
   3.947563962857033*^9}, {3.947564037225544*^9, 3.947564049095524*^9}, {
